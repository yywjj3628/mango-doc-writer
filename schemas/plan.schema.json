{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mango-doc-writer.local/schemas/plan.schema.json",
  "title": "Mango Doc Writer Plan Result",
  "description": "结构规划阶段输出结构，用于在正式起草前规划标题、主送单位、文案结构、称谓口径、缺失字段和风险提示。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_summary",
    "doc_type",
    "direction",
    "style_level",
    "risk_level",
    "title_plan",
    "addressee_plan",
    "signer_plan",
    "sections",
    "style_directives",
    "title_rules",
    "addressee_resolution",
    "signer_resolution",
    "title_suggestions",
    "missing_fields",
    "cannot_infer",
    "risk_flags",
    "manual_confirmation_fields",
    "draft_directives"
  ],
  "properties": {
    "plan_summary": {
      "type": "string",
      "minLength": 1
    },
    "doc_type": {
      "type": "string"
    },
    "direction": {
      "type": "string"
    },
    "style_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "title_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_title", "title_type", "title_confidence", "title_basis", "title_risks", "alternative_titles"],
      "properties": {
        "recommended_title": {
          "type": "string",
          "minLength": 1
        },
        "title_type": {
          "type": "string"
        },
        "title_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "title_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternative_titles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "addressee_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_addressee", "source", "confidence", "needs_manual_confirmation", "note"],
      "properties": {
        "recommended_addressee": {
          "type": ["string", "null"]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_manual_confirmation": {
          "type": "boolean"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "signer_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_signer", "source", "confidence", "needs_manual_confirmation", "note"],
      "properties": {
        "recommended_signer": {
          "type": ["string", "null"]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_manual_confirmation": {
          "type": "boolean"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "section_name", "purpose", "content_guidance", "fact_bindings", "blocked_items", "word_count_estimate", "needs_manual_input"],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "section_name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "content_guidance": {
            "type": "string",
            "minLength": 1
          },
          "fact_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact_type", "fact_value", "source_from_extract"],
              "properties": {
                "fact_type": {
                  "type": "string"
                },
                "fact_value": {
                  "type": "string"
                },
                "source_from_extract": {
                  "type": "boolean"
                }
              }
            }
          },
          "blocked_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "word_count_estimate": {
            "type": "integer",
            "minimum": 0
          },
          "needs_manual_input": {
            "type": "boolean"
          }
        }
      }
    },
    "style_directives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_tone", "key_expressions", "forbidden_expressions", "style_reference"],
      "properties": {
        "overall_tone": {
          "type": "string"
        },
        "key_expressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_expressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style_reference": {
          "type": "string"
        }
      }
    },
    "title_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "addressee_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_addressee", "source", "confidence", "needs_manual_confirmation", "note"],
      "properties": {
        "recommended_addressee": {
          "type": ["string", "null"]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_manual_confirmation": {
          "type": "boolean"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "signer_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_signer", "source", "confidence", "needs_manual_confirmation", "note"],
      "properties": {
        "recommended_signer": {
          "type": ["string", "null"]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_manual_confirmation": {
          "type": "boolean"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "title_suggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_title", "alternative_titles", "title_rules"],
      "properties": {
        "recommended_title": {
          "type": "string"
        },
        "alternative_titles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    },
    "cannot_infer": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "detail", "level"],
        "properties": {
          "type": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        }
      }
    },
    "manual_confirmation_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    },
    "draft_directives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_word_count_estimate", "must_use_facts", "must_avoid", "format_requirements"],
      "properties": {
        "total_word_count_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "must_use_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controlled_expansion_directives": {
          "type": "object",
          "description": "assisted_expansion 模式下的扩写指令",
          "properties": {
            "allowed_expansions": {
              "type": "array",
              "items": {"type": "string"}
            },
            "must_mark_confirmation": {
              "type": "array",
              "items": {"type": "string"}
            },
            "forbidden_expansions": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "creative_mimic_directives": {
          "type": "object",
          "description": "creative_mimic 模式下的仿写指令",
          "properties": {
            "style_mimic_intensity": {"type": "string"},
            "official_use_allowed": {"type": "boolean"},
            "draft_disclaimer_required": {"type": "boolean"},
            "allowed_mimic": {
              "type": "array",
              "items": {"type": "string"}
            },
            "forbidden_mimic": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "generation_mode": {
      "type": "string",
      "description": "v0.1.4: 当前写作模式"
    },
    "expansion_boundaries": {
      "type": "object",
      "description": "v0.1.4: 扩写边界汇总",
      "properties": {
        "mode": {"type": "string"},
        "expansion_enabled": {"type": "boolean"},
        "no_specific_fact_fabrication": {"type": "boolean"},
        "rag_style_only": {"type": "boolean"},
        "all_expansions_labeled": {"type": "boolean"}
      }
    }
  }
}
