{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mango-doc-writer.local/schemas/rewrite.schema.json",
  "title": "Mango Doc Writer Rewrite Result",
  "description": "二次修订阶段输出结构，用于根据 review 结果修订初稿，输出最终 Markdown、修订记录、剩余风险和人工确认项。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rewrite_summary",
    "doc_type",
    "direction",
    "style_level",
    "risk_level",
    "final_markdown",
    "revision_report",
    "fact_usage_report",
    "terminology_usage_report",
    "resolved_issues",
    "unresolved_issues",
    "remaining_risks",
    "manual_confirmation_fields",
    "final_checks",
    "rewrite_policy"
  ],
  "properties": {
    "rewrite_summary": {
      "type": "string",
      "minLength": 1,
      "description": "对本次修订的简要说明"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "新闻稿",
        "通知",
        "请示",
        "报告",
        "函",
        "总结",
        "汇报材料",
        "领导讲话",
        "会议纪要",
        "通报",
        "其他"
      ],
      "description": "最终稿的文种类型，必须与 classify_result.doc_type 一致"
    },
    "direction": {
      "type": "string",
      "enum": [
        "上行文",
        "下行文",
        "平行文",
        "内部材料",
        "对外宣传",
        "综合材料",
        "其他"
      ],
      "description": "行文方向"
    },
    "style_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "风格强度等级"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "最终稿的整体风险等级"
    },
    "final_markdown": {
      "type": "string",
      "minLength": 1,
      "description": "修订后的最终 Markdown 正文"
    },
    "revision_report": {
      "type": "array",
      "description": "每一处修改的详细记录",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "issue_id",
          "action",
          "before",
          "after",
          "reason",
          "basis"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "description": "修订记录唯一编号"
          },
          "issue_id": {
            "type": "string",
            "description": "关联的 review_result.issues.issue_id"
          },
          "action": {
            "type": "string",
            "enum": [
              "delete",
              "replace",
              "restructure",
              "add_placeholder",
              "add_warning",
              "keep"
            ],
            "description": "修订操作类型"
          },
          "before": {
            "type": [
              "string",
              "null"
            ],
            "description": "修改前的原文（delete 时为被删除的文本）"
          },
          "after": {
            "type": [
              "string",
              "null"
            ],
            "description": "修改后的文本（delete 时为 null）"
          },
          "reason": {
            "type": "string",
            "description": "修改原因"
          },
          "basis": {
            "type": "string",
            "description": "修改依据（如 extract_result.fact_items、doc_type_rules 等）"
          }
        }
      }
    },
    "fact_usage_report": {
      "type": "array",
      "description": "最终稿中每个事实的来源追溯",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "final_text",
          "fact_type",
          "fact_value",
          "source_text",
          "source",
          "confidence"
        ],
        "properties": {
          "final_text": {
            "type": "string",
            "description": "final_markdown 中事实出现的文本片段"
          },
          "fact_type": {
            "type": "string",
            "description": "事实类型（achievement、request、data 等）"
          },
          "fact_value": {
            "type": "string",
            "description": "事实内容"
          },
          "source_text": {
            "type": "string",
            "description": "来源原始文本"
          },
          "source": {
            "type": "string",
            "description": "事实来源标识（extract_result.fact_items、draft_result 等）"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "来源可信度"
          }
        }
      }
    },
    "terminology_usage_report": {
      "type": "array",
      "description": "最终稿中称谓使用记录",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "raw_value",
          "used_value",
          "type",
          "source",
          "confidence",
          "needs_manual_confirmation",
          "note"
        ],
        "properties": {
          "raw_value": {
            "type": "string",
            "description": "用户原始表述"
          },
          "used_value": {
            "type": "string",
            "description": "final_markdown 中实际使用的表述"
          },
          "type": {
            "type": "string",
            "enum": [
              "organization",
              "leader",
              "product",
              "strategic_term",
              "other"
            ],
            "description": "称谓类型"
          },
          "source": {
            "type": "string",
            "description": "称谓来源（org_title_dictionary、user_input 等）"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "称谓可信度"
          },
          "needs_manual_confirmation": {
            "type": "boolean",
            "description": "是否需要人工确认"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "补充说明"
          }
        }
      }
    },
    "resolved_issues": {
      "type": "array",
      "description": "已修复的 review issue 列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "resolution",
          "basis"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "关联的 review_result.issues.issue_id"
          },
          "resolution": {
            "type": "string",
            "description": "修复方式说明"
          },
          "basis": {
            "type": "string",
            "description": "修复依据"
          }
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "description": "无法修复的 review issue 列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "reason",
          "required_action"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "关联的 review_result.issues.issue_id"
          },
          "reason": {
            "type": "string",
            "description": "无法修复的原因"
          },
          "required_action": {
            "type": "string",
            "description": "建议的人工处理方式"
          }
        }
      }
    },
    "remaining_risks": {
      "type": "array",
      "description": "最终稿仍存在的风险",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "type",
          "detail",
          "action"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "风险等级"
          },
          "type": {
            "type": "string",
            "description": "风险类型（missing_field、terminology_unconfirmed 等）"
          },
          "detail": {
            "type": "string",
            "description": "风险详细描述"
          },
          "action": {
            "type": "string",
            "description": "建议的应对措施"
          }
        }
      }
    },
    "manual_confirmation_fields": {
      "type": "array",
      "description": "最终稿中仍需人工确认的字段",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason",
          "impact",
          "required_before_final"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "待确认字段名称"
          },
          "reason": {
            "type": "string",
            "description": "需要确认的原因"
          },
          "impact": {
            "type": "string",
            "description": "如不确认可能造成的影响"
          },
          "required_before_final": {
            "type": "boolean",
            "description": "正式使用前是否必须确认"
          }
        }
      }
    },
    "final_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_type_fixed",
        "unsupported_facts_removed",
        "blocked_items_removed",
        "terminology_checked",
        "manual_confirmations_preserved"
      ],
      "description": "最终稿质量自检结果",
      "properties": {
        "doc_type_fixed": {
          "type": "boolean",
          "description": "文种错误是否已修正"
        },
        "unsupported_facts_removed": {
          "type": "boolean",
          "description": "无依据事实是否已删除"
        },
        "blocked_items_removed": {
          "type": "boolean",
          "description": "禁止项是否已处理"
        },
        "terminology_checked": {
          "type": "boolean",
          "description": "称谓是否已校验"
        },
        "manual_confirmations_preserved": {
          "type": "boolean",
          "description": "人工确认项是否已保留"
        }
      }
    },
    "rewrite_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_rewritten",
        "no_new_facts",
        "use_only_extract_facts",
        "no_rag_call",
        "follow_review_instructions",
        "follow_doc_type_rules",
        "follow_org_title_dictionary"
      ],
      "description": "rewrite 阶段策略声明，七项必须为 true",
      "properties": {
        "body_rewritten": {
          "type": "boolean",
          "const": true,
          "description": "已对正文进行修订"
        },
        "no_new_facts": {
          "type": "boolean",
          "const": true,
          "description": "未新增任何事实"
        },
        "use_only_extract_facts": {
          "type": "boolean",
          "const": true,
          "description": "只使用 extract_result 中的事实"
        },
        "no_rag_call": {
          "type": "boolean",
          "const": true,
          "description": "未调用 RAG"
        },
        "follow_review_instructions": {
          "type": "boolean",
          "const": true,
          "description": "遵循了 review_result 的修订指令"
        },
        "follow_doc_type_rules": {
          "type": "boolean",
          "const": true,
          "description": "遵循了文种规则"
        },
        "follow_org_title_dictionary": {
          "type": "boolean",
          "const": true,
          "description": "遵循了称谓口径库"
        }
      }
    }
  }
}
