{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mango-doc-writer Rule Candidate Schema v0.2.0",
  "description": "规则候选 JSONL schema，用于 C2.2+ 语料萃取和人工确认流程",
  "type": "object",
  "required": ["candidate_id", "candidate_type", "key", "value", "evidence", "review"],
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "候选唯一 ID，格式：{type}_{short_hash}，如 leader_顾懿_a3f2"
    },
    "candidate_type": {
      "type": "string",
      "enum": ["leader_title", "subsidiary_affiliation", "company_alias", "doc_type_rule", "style_phrase", "risk_rule", "field_hint_rule"],
      "description": "候选规则类型"
    },
    "key": {
      "type": "string",
      "description": "候选的主键/名称，如人名、组织名、文种名"
    },
    "value": {
      "type": "object",
      "description": "候选的结构化值，格式因 candidate_type 而异"
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_text", "source_doc"],
      "properties": {
        "evidence_text": {
          "type": "string",
          "description": "原始语料中的证据文本（原文摘录）"
        },
        "source_doc": {
          "type": "string",
          "description": "证据来源文档路径或名称"
        },
        "source_date": {
          "type": ["string", "null"],
          "description": "来源文档日期，ISO 8601 格式，可为空"
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0,
          "description": "该候选在语料中出现的次数"
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["confidence", "needs_manual_review", "suggested_action"],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "萃取置信度"
        },
        "is_time_sensitive": {
          "type": "boolean",
          "default": false,
          "description": "是否时效敏感（如领导职务变动）"
        },
        "needs_manual_review": {
          "type": "boolean",
          "description": "是否需要人工确认"
        },
        "conflict_with_existing": {
          "type": ["string", "null"],
          "description": "与现有规则的冲突描述，无冲突为 null"
        },
        "suggested_action": {
          "type": "string",
          "enum": ["auto_import", "human_confirm", "defer", "discard"],
          "description": "建议动作：auto_import=直接导入, human_confirm=需人工确认, defer=暂缓, discard=弃用"
        },
        "reviewer_decision": {
          "type": ["string", "null"],
          "enum": ["approved", "modified", "rejected", "deferred", null],
          "description": "人工审核决定，未审核时为 null"
        },
        "reviewer_note": {
          "type": ["string", "null"],
          "description": "人工审核备注"
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "description": "审核时间，ISO 8601 格式"
        },
        "corrected_value": {
          "type": ["object", "null"],
          "description": "人工修正后的正确值，仅在 reviewer_decision=modified 时填写"
        },
        "apply_to_formal_rules": {
          "type": ["boolean", "null"],
          "description": "是否合并进正式规则库，仅在审核完成后填写"
        }
      }
    },
    "created_at": {
      "type": "string",
      "description": "候选创建时间，ISO 8601 格式"
    }
  },
  "definitions": {
    "leader_title": {
      "description": "领导姓名与职务候选",
      "value_schema": {
        "person_name": "string - 领导姓名",
        "title": "string - 职务",
        "organization_scope": "string - 组织范围标识（如 jiuzhirun, dianguang_media）",
        "organization_name": "string - 所属组织全称",
        "accepted_titles": "string[] - 可接受的职务表述列表"
      },
      "example": {
        "candidate_id": "leader_顾懿_a3f2",
        "candidate_type": "leader_title",
        "key": "顾懿",
        "value": {
          "person_name": "顾懿",
          "title": "久之润总经理",
          "organization_scope": "jiuzhirun",
          "organization_name": "上海久之润信息技术有限公司",
          "accepted_titles": ["久之润总经理", "上海久之润信息技术有限公司总经理"]
        },
        "evidence": {
          "evidence_text": "久之润总经理顾懿出席会议并讲话",
          "source_doc": "久之润2025年目标责任书.md",
          "source_date": "2025-01-01",
          "evidence_count": 1
        },
        "review": {
          "confidence": "high",
          "is_time_sensitive": true,
          "needs_manual_review": true,
          "conflict_with_existing": null,
          "suggested_action": "human_confirm",
          "reviewer_decision": null,
          "reviewer_note": null,
          "reviewed_at": null,
          "corrected_value": null,
          "apply_to_formal_rules": null
        },
        "created_at": "2026-06-02T14:34:00Z"
      }
    },
    "subsidiary_affiliation": {
      "description": "子公司/关联主体归属口径候选",
      "value_schema": {
        "entity_name": "string - 主体名称",
        "parent_entity": "string - 上级/归属主体名称",
        "relation_type": "string - 关系类型：subsidiary_of(全资子公司), affiliated_to(关联), managed_by(管理关系)",
        "organization_scope": "string - 组织范围标识",
        "business_type": "string|null - 业务类型",
        "short_name": "string|null - 简称"
      },
      "example": {
        "candidate_id": "sub_久之润_b7d1",
        "candidate_type": "subsidiary_affiliation",
        "key": "久之润",
        "value": {
          "entity_name": "上海久之润信息技术有限公司",
          "parent_entity": "湖南电广传媒股份有限公司",
          "relation_type": "subsidiary_of",
          "organization_scope": "jiuzhirun",
          "business_type": "网络游戏",
          "short_name": "久之润"
        },
        "evidence": {
          "evidence_text": "久之润作为电广传媒全资子公司",
          "source_doc": "久之润2025年目标责任书.md",
          "source_date": "2025-01-01",
          "evidence_count": 1
        },
        "review": {
          "confidence": "high",
          "is_time_sensitive": false,
          "needs_manual_review": true,
          "conflict_with_existing": null,
          "suggested_action": "human_confirm",
          "reviewer_decision": null,
          "reviewer_note": null,
          "reviewed_at": null
        },
        "created_at": "2026-06-02T14:34:00Z"
      }
    },
    "company_alias": {
      "description": "公司简称、别称、适用口径候选",
      "value_schema": {
        "full_name": "string - 全称",
        "alias": "string - 简称/别称",
        "allowed_context": "string[] - 适用场景（如：新闻稿, 汇报材料, 领导讲话）",
        "forbidden_context": "string[] - 禁用场景",
        "organization_scope": "string - 组织范围标识"
      },
      "example": {
        "candidate_id": "alias_久之润_c4e9",
        "candidate_type": "company_alias",
        "key": "久之润",
