        "review": {
          "confidence": "high",
          "is_time_sensitive": false,
          "needs_manual_review": false,
          "conflict_with_existing": null,
          "suggested_action": "auto_import",
          "reviewer_decision": null,
          "reviewer_note": null,
          "reviewed_at": null
        },
        "created_at": "2026-06-02T14:34:00Z"
      }
