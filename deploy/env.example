DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型：用于全量回归，控制成本
DEEPSEEK_MODEL=deepseek-v4-flash

# 兜底模型：仅在失败重试时使用
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

DEEPSEEK_ENABLE_FALLBACK=true
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2

# 项目路径
MANGO_DOC_WRITER_ROOT=/home/ywj/.openclaw/workspace/skills/mango-doc-writer
MANGO_DOC_WRITER_OUTPUT_DIR=/home/ywj/.openclaw/workspace/skills/mango-doc-writer/outputs
MANGO_DOC_WRITER_REPORTS_DIR=/home/ywj/.openclaw/workspace/skills/mango-doc-writer/tests/reports
MANGO_DOC_WRITER_LOG_DIR=/home/ywj/.openclaw/workspace/skills/mango-doc-writer/logs

# RAG 配置
RAG_ENABLED=true
RAG_BASE_URL=http://localhost:8000/search
RAG_ENABLE_MULTI_COLLECTION=true
RAG_TOP_K_TOTAL=6

# Collection 配置
RAG_COLLECTION_STYLE=mango_style_docs
RAG_COLLECTION_BUSINESS=jiuyou_docs
RAG_COLLECTION_DISABLED=openclaw_memory

# 各文种路由参数
RAG_NEWS_STYLE_K=4
RAG_NEWS_BUSINESS_K=2
RAG_SPEECH_STYLE_K=3
RAG_SPEECH_BUSINESS_K=3
RAG_REPORT_STYLE_K=1
RAG_REPORT_BUSINESS_K=5
RAG_OFFICIAL_BUSINESS_K=6

# Typeset Engine（可选，生成 DOCX）
TYPESET_ENGINE_ENABLED=true
TYPESET_ENGINE_BASE_URL=http://localhost:9090

# ── 质量门禁（v0.1.3 新增）───────────────────────────
# 是否启用质量门禁（false 时回退 v0.1.2 旧流程）
QUALITY_GATE_ENABLED=true
# 达标阈值：六大维度评分低于此值视为不达标（0-10，默认 8）
QUALITY_GATE_THRESHOLD=8
# 最大返修轮次：达到后仍不通过则 warn_and_output（默认 2）
QUALITY_GATE_MAX_ROUNDS=2
